PORT=8080
NODE_ENV=development
CORS_ORIGIN=https://akbaralievernis.github.io
JWT_SECRET=replace_with_long_random
JWT_EXPIRES_IN=7d
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
# If you prefer hash-based password, set ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=$2a$10$...

# LLM configuration
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_with_server_key
LLM_MODEL=gpt-4o-mini

# STT configuration
STT_PROVIDER=google
GOOGLE_STT_LANGUAGE=ky-KG
GOOGLE_STT_SAMPLE_RATE=48000
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project
GOOGLE_CLOUD_API_KEY=your_google_api_key

# TTS configuration
TTS_PROVIDER=google
GOOGLE_TTS_VOICE=ky-KG-Standard-A
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_API_KEY=your_google_api_key

# Memory
DB_PATH=./data/aris.sqlite
MEMORY_SUMMARY_INTERVAL=10
MAX_TURNS_CONTEXT=12
